# Copy to .env and fill in. .env is gitignored - never commit real keys.
# Generate the proxy key with: openssl rand -hex 24
PROXY_API_KEY=

# Sonarr pair. Leave all four blank to run Radarr only.
ENGLISH_SONARR_URL=http://sonarr.example.lan:8989
ENGLISH_SONARR_API_KEY=
ANIME_SONARR_URL=http://sonarr-anime.example.lan:8987
ANIME_SONARR_API_KEY=

# Radarr pair. Leave all four blank to run Sonarr only.
ENGLISH_RADARR_URL=http://radarr.example.lan:7878
ENGLISH_RADARR_API_KEY=
ANIME_RADARR_URL=http://radarr-anime.example.lan:7879
ANIME_RADARR_API_KEY=
